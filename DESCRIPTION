Package: scONCO
Title: Hierarchical Cell-Type Annotation with a Sample-Level Tumour Test for
    Single-Cell RNA-Seq of Solid Tumours
Version: 1.2.0
Date: 2026-10-13
Authors@R: c(
    person("Chia-Jung", "Chang",
           email = "charlene.cj.chang@gmail.com",
           role  = c("aut", "cre"),
           comment = c(ORCID = "0000-0000-0000-0000")),
    person("Yang-Hong", "Dai",
